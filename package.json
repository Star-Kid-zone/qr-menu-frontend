    "@lglab/react-qr-code": "^1.7.0",
    "@lottiefiles/dotlottie-react": "^0.21.1",
    "@thumbmarkjs/thumbmarkjs": "^1.10.1",
    "axios": "^1.21.0",
    "framer-motion": "^12.43.0",
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
