# Public app origin used to build absolute URLs (metadata, sitemap, canonical links).
# Required in production — the app throws a startup error if unset (see src/config/app.constants.ts).
NEXT_PUBLIC_APP_BASE_URL=https://app.qrmenu.app

# Server-only alternate for NEXT_PUBLIC_APP_BASE_URL (used only if the public var isn't set).
APP_BASE_URL=https://app.qrmenu.app

# Base URL the browser's axios client calls. Defaults to "/api" in dev, which
# relies on the Next.js rewrite proxy (see next.config.ts) forwarding to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE_URL=/api

# Backend origin the Next.js dev/proxy server forwards /api/* requests to, and
# that server-side data fetching (src/config/app.constants.ts) calls directly.
# Required in production (no silent localhost fallback) — see next.config.ts and app.constants.ts.
API_PROXY_TARGET=https://api.qrmenu.app

# Root domain that tenant subdomains are served from, e.g. <slug>.qrmenu.app.
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=qrmenu.app

# Optional CDN/custom hostname fronting uploaded images (e.g. CloudFront domain).
# If unset, next/image only allows the S3 bucket pattern (*.s3.*.amazonaws.com)
# plus localhost/127.0.0.1 for the local-disk upload fallback in dev.
NEXT_PUBLIC_ASSETS_HOST=cdn.qrmenu.app

# Standard Next.js environment mode. Set automatically by the build/start
# scripts; only override for local testing of production behavior.
NODE_ENV=development
