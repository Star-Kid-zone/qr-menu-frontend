# Public app origin used to build absolute URLs (metadata, sitemap, canonical links).
# Required in production — the app throws a startup error if unset (see src/config/app.constants.ts).
NEXT_PUBLIC_APP_BASE_URL=https://app.mynagaram.com

# Server-only alternate for NEXT_PUBLIC_APP_BASE_URL (used only if the public var isn't set).
APP_BASE_URL=https://app.mynagaram.com

# Base URL the browser's axios client calls directly (no server-side proxy).
# Local dev: leave as "/api" only if you still run a proxy; otherwise point it
# at your local backend, e.g. http://127.0.0.1:7000/api.
# Production: must be the absolute backend URL, e.g. https://apigateway.mynagaram.com/api.
# The backend must allow this origin in CORS_ORIGIN (see backend .env.example).
NEXT_PUBLIC_API_BASE_URL=https://apigateway.mynagaram.com/api

# Backend origin used only for server-side data fetching (SSR/server components —
# see SERVER_API_BASE_URL in src/config/app.constants.ts). No trailing /api.
# Required in production (no silent localhost fallback).
API_PROXY_TARGET=https://apigateway.mynagaram.com

# Root domain that tenant subdomains are served from, e.g. <slug>.mynagaram.com.
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=mynagaram.com

# Optional CDN/custom hostname fronting uploaded images (e.g. CloudFront domain).
# If unset, next/image only allows the S3 bucket pattern (*.s3.*.amazonaws.com)
# plus localhost/127.0.0.1 for the local-disk upload fallback in dev.
NEXT_PUBLIC_ASSETS_HOST=cdn.mynagaram.com

# Standard Next.js environment mode. Set automatically by the build/start
# scripts; only override for local testing of production behavior.
NODE_ENV=development
